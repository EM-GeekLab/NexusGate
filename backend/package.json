{
  "name": "nexus-gate-server",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "bun check && NODE_ENV=production COMMIT_SHA=$(git rev-parse HEAD) bun build src/index.ts --target bun --outdir out/ --env='COMMIT_SHA*'",
    "check:tsgo": "tsgo -p tsconfig.check.json",
    "check": "tsc -p tsconfig.check.json",
    "dev": "COMMIT_SHA=$(git rev-parse HEAD) CONSOLA_LEVEL=9999 FRONTEND_DIR=../frontend/dist DOCS_DIR=docs bun --watch --hot --no-clear-screen --inspect src/index.ts",
    "test": "bun test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/server-timing": "^1.4.1",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@loglayer/transport-simple-pretty-terminal": "^2.3.1",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "ioredis": "^5.11.1",
    "loglayer": "^8.5.0",
    "nodemailer": "^7.0.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^7.0.12",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "drizzle-kit": "^0.31.11",
    "openai": "^6.49.0",
    "oxfmt": "^0.24.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.11.5",
    "pg": "^8.23.0",
    "typescript": "^5.9.3"
  }
}
